# Copy to server/.env (or export in your shell) - all values optional.

# API port
PORT=4000

# Enables /api/admin. Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=

# Optional LLM for natural-language replanning (OpenAI-compatible).
# Without these the server uses the built-in rule-based parser and says so.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional OSRM-compatible routing endpoint (no key needed for the public demo).
OSRM_URL=https://router.project-osrm.org